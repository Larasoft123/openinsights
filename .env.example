# OpenInsights Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database (PostgreSQL with pgvector)
# ============================================
DATABASE_URL="postgresql://openinsights:openinsights_dev@localhost:5433/openinsights"

# ============================================
# Redis (BullMQ job queues)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# Storage (MinIO / S3)
# ============================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="openinsights"
S3_SECRET_KEY="openinsights_dev"
S3_BUCKET="openinsights"
S3_REGION="us-east-1"

# ============================================
# Worker Configuration
# ============================================
WORKER_CONCURRENCY="2"

# ============================================
# Encryption (API keys at rest)
# ============================================
# Required for encrypting organization API keys in database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ============================================
# Authentication (NextAuth.js)
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (optional)
# Create at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (optional)
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================
# Application
# ============================================
NODE_ENV="development"
LOG_LEVEL="debug"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Branding (Self-Hosted Customization)
# ============================================
# Customize these for your self-hosted instance
NEXT_PUBLIC_SITE_NAME="OpenInsights"
NEXT_PUBLIC_SITE_DESCRIPTION="Transform qualitative research with AI-powered transcription, semantic search, and rapid tagging."
# Custom logo URL (optional) - leave empty to use default OpenInsights logo
# Example: "/my-company-logo.png" or "https://example.com/logo.png"
NEXT_PUBLIC_LOGO_URL=""

# ============================================
# AI Configuration (IMPORTANT)
# ============================================
# AI providers are configured via the Settings page in the application.
# Go to Settings > AI Settings to configure:
#
# Transcription (Speech-to-Text):
#   - Deepgram (recommended, native diarization)
#   - AssemblyAI (high-accuracy diarization)
#   - OpenAI Whisper (industry-standard)
#   - WhisperX (self-hosted, requires GPU)
#
# General AI (Summaries & Clustering):
#   - Gemini (recommended)
#   - OpenAI
#
# For self-hosted WhisperX, see docker-compose.yml:
#   docker compose --profile whisperx up -d   # WhisperX (GPU required)

# ============================================
# Embeddings (Ollama - required)
# ============================================
# Embeddings use Ollama with nomic-embed-text model (768 dimensions).
# This is configured automatically by the setup script.
#
# Start Ollama:
#   docker compose --profile ollama up -d
#   OR install manually: https://ollama.ai
#
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
