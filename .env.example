# OpenInsights Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database (PostgreSQL with pgvector)
# ============================================
DATABASE_URL="postgresql://openinsights:openinsights_dev@localhost:5433/openinsights"

# ============================================
# Redis (BullMQ job queues)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# Storage (MinIO / S3)
# ============================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="openinsights"
S3_SECRET_KEY="openinsights_dev"
S3_BUCKET="openinsights"
S3_REGION="us-east-1"

# ============================================
# AI Provider Selection
# ============================================
# Options: "gemini" (recommended) | "openai"
# Gemini: Native video input, 1M+ context window
# OpenAI: Requires audio extraction first (FFmpeg)
AI_PROVIDER="gemini"

# ============================================
# Gemini (recommended for video transcription)
# ============================================
GOOGLE_GENERATIVE_AI_API_KEY=""

# ============================================
# OpenAI (fallback transcription)
# ============================================
# Used for Whisper transcription when AI_PROVIDER=openai
# Also used for embeddings when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=""

# ============================================
# Embedding Provider (deployment-time decision)
# ============================================
# IMPORTANT: This is a one-time choice. Changing providers after data
# exists requires dropping all embeddings and re-vectorizing.
#
# Options:
# - "openai": text-embedding-3-small (1536 dims) - Best quality, cloud
# - "gemini": text-embedding-004 (768 dims) - Good quality, cloud
# - "ollama": nomic-embed-text (768 dims) - Local/private, self-hosted
#
# For full privacy (no cloud AI), use EMBEDDING_PROVIDER=ollama
EMBEDDING_PROVIDER="openai"

# ============================================
# Ollama (local/private AI - optional)
# ============================================
# For self-hosted, privacy-first deployments
# Install: https://ollama.ai
# Pull model: ollama pull nomic-embed-text
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ============================================
# Worker Configuration
# ============================================
WORKER_CONCURRENCY="2"

# ============================================
# Authentication (NextAuth.js)
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (optional)
# Create at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (optional)
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================
# Application
# ============================================
NODE_ENV="development"
LOG_LEVEL="debug"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
