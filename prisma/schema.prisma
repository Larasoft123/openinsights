// OpenInsights - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================
// Enums
// ============================================

enum ProcessingStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum SummaryStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum UsageMetric {
  STORAGE_BYTES
  TRANSCRIPTION_SECONDS
  AI_TOKENS_INPUT
  AI_TOKENS_OUTPUT
}

// ============================================
// Auth Models (NextAuth.js)
// ============================================

/// User - Authenticated user account
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String? // For credentials provider (hashed)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Legacy: will be removed after tenant migration
  workspaceId String?    @unique @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  accounts    Account[]
  sessions    Session[]
  shareLinks  ShareLink[]
  memberships OrganizationMember[]

  @@map("users")
}

/// Account - OAuth provider connection
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Session - User session for database strategy
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// VerificationToken - Email verification tokens
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Organization Models (Multi-Tenant)
// ============================================

/// Organization - Tenant container (1 per self-hosted, N for cloud)
model Organization {
  id         String @id @default(cuid())
  name       String
  slug       String @unique
  schemaName String @unique @map("schema_name") // e.g., "tenant_default" or "tenant_abc123"

  // ============================================
  // Transcription (STT) Configuration
  // ============================================
  // Cloud: "deepgram" | "assemblyai" | "openai"
  // Self-hosted: "whisperx"
  transcriptionProvider  String? @map("transcription_provider")
  encryptedDeepgramKey   String? @map("encrypted_deepgram_key")
  encryptedAssemblyaiKey String? @map("encrypted_assemblyai_key")
  whisperxEndpoint       String? @map("whisperx_endpoint") // Self-hosted WhisperX URL

  // ============================================
  // Embedding Configuration
  // ============================================
  // Cloud: "openai" (default) | "gemini"
  // Self-hosted: "ollama"
  embeddingProvider  String? @map("embedding_provider")
  embeddingDimension Int     @default(1536) @map("embedding_dimension") // 1536 for OpenAI, 768 for Gemini/Ollama
  ollamaBaseUrl      String? @map("ollama_base_url")

  // ============================================
  // General AI Configuration (summaries, clustering)
  // ============================================
  // "gemini" (default) | "openai"
  generalAiProvider String? @map("general_ai_provider")

  // ============================================
  // Model Selection (fetched from provider APIs)
  // ============================================
  transcriptionModel String? @map("transcription_model") // e.g., "nova-3", "large-v3"
  embeddingModel     String? @map("embedding_model")     // e.g., "text-embedding-3-small"
  generalAiModel     String? @map("general_ai_model")    // e.g., "gemini-2.5-flash", "gpt-4o-mini"

  // ============================================
  // Shared API Keys (encrypted with AES-256-GCM)
  // ============================================
  encryptedOpenaiKey String? @map("encrypted_openai_key") // Used for transcription + embeddings
  encryptedGeminiKey String? @map("encrypted_gemini_key") // Used for embeddings + general AI

  // Platform-managed keys (cloud only - uses platform's keys)
  usePlatformKeys Boolean @default(false) @map("use_platform_keys")

  // ============================================
  // Branding (self-hosted customization)
  // ============================================
  logoUrl      String? @map("logo_url")
  primaryColor String? @map("primary_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      OrganizationMember[]
  subscription Subscription?
  usageRecords UsageRecord[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

/// OrganizationMember - User membership in organization
model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  role           OrgRole   @default(MEMBER)
  invitedAt      DateTime  @default(now()) @map("invited_at")
  joinedAt       DateTime? @map("joined_at") // null = pending invite

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ============================================
// Billing Models (empty for self-hosted)
// ============================================

/// Plan - Subscription tier (self-hosted has 1 unlimited plan)
model Plan {
  id            String  @id @default(cuid())
  name          String // "Self-Hosted", "Starter", "Pro", "Enterprise"
  stripePriceId String? @unique @map("stripe_price_id")
  priceMonthly  Int     @default(0) @map("price_monthly") // cents, 0 for free

  // Limits (0 = unlimited, used for self-hosted)
  maxUsers             Int @default(0) @map("max_users")
  maxStorageGb         Int @default(0) @map("max_storage_gb")
  maxTranscriptionMins Int @default(0) @map("max_transcription_mins")
  maxProjects          Int @default(0) @map("max_projects")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// Subscription - Organization's current plan (self-hosted has 1 free subscription)
model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique @map("organization_id")
  planId               String    @map("plan_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  status               SubStatus @default(ACTIVE)
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// UsageRecord - Metering for billing (not used for self-hosted)
model UsageRecord {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  metric         UsageMetric
  value          BigInt // bytes, seconds, tokens
  recordedAt     DateTime    @default(now()) @map("recorded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, recordedAt])
  @@map("usage_records")
}

// ============================================
// Audit Log (compliance)
// ============================================

/// AuditLog - Activity tracking for compliance (optional for self-hosted)
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id") // null for system actions
  action         String // "project.created", "source.deleted", "member.invited"
  entityType     String   @map("entity_type") // "project", "source", "member"
  entityId       String?  @map("entity_id")
  metadata       Json? // Additional context
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// ============================================
// Core Models (Legacy - will move to tenant schema)
// ============================================

/// Workspace - Multi-tenant container for projects
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // AI Settings (null = use environment variable defaults)
  aiProvider               String? @map("ai_provider") // "gemini" | "openai"
  openaiTranscriptionModel String? @map("openai_transcription_model") // "whisper-1" | "gpt-4o-transcribe-diarize"
  embeddingProvider        String? @map("embedding_provider") // "openai" | "gemini" | "ollama"

  // API Keys (null = use environment variable)
  geminiApiKey  String? @map("gemini_api_key")
  openaiApiKey  String? @map("openai_api_key")
  ollamaBaseUrl String? @map("ollama_base_url") // URL, not a key (e.g., http://localhost:11434)

  owner    User?
  projects Project[]

  @@map("workspaces")
}

/// Project - Research container within a workspace
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // AI Summary
  summary            Json?          @map("summary") // Structured summary: { researchObjectives, keyFindings, participantOverview, recommendations }
  summaryStatus      SummaryStatus? @map("summary_status")
  summaryGeneratedAt DateTime?      @map("summary_generated_at")

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sources      Source[]
  tags         Tag[]
  themes       Theme[]
  shareLinks   ShareLink[]
  speakerNames SpeakerName[]

  @@map("projects")
}

/// Source - Video/audio file for transcription
model Source {
  id        String           @id @default(cuid())
  title     String
  fileName  String           @map("file_name")
  fileUrl   String           @map("file_url")
  fileType  String           @map("file_type")
  duration  Int? // Duration in seconds
  status    ProcessingStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Processing progress tracking
  processingStep      String?   @map("processing_step") // "transcribing" | "vectorizing"
  processingProgress  Int?      @map("processing_progress") // 0-100 for vectorization
  processingStartedAt DateTime? @map("processing_started_at")

  // Soft delete (trash functionality)
  deletedAt DateTime? @map("deleted_at") // null = active, timestamp = trashed

  // AI Summary
  summary            Json?          @map("summary") // Structured summary: { keyTopics, keyQuotes, participants }
  summaryStatus      SummaryStatus? @map("summary_status")
  summaryGeneratedAt DateTime?      @map("summary_generated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  segments   TranscriptSegment[]
  shareLinks ShareLink[]

  @@map("sources")
}

/// TranscriptSegment - Timestamped text from transcription
model TranscriptSegment {
  id        String                       @id @default(cuid())
  content   String
  startTime Float                        @map("start_time") // Time in seconds
  endTime   Float                        @map("end_time") // Time in seconds
  speakerId String?                      @map("speaker_id")
  // pgvector embedding column - actual dimension set via setup-db.sh (1536 for OpenAI, 768 for Gemini/Ollama)
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  sourceId String @map("source_id")
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  highlights Highlight[]

  @@index([sourceId])
  @@map("transcript_segments")
}

/// Tag - Taxonomy for organizing highlights
model Tag {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#3B82F6")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  highlights Highlight[]

  @@unique([projectId, name])
  @@map("tags")
}

/// Highlight - Tagged selection from transcript
model Highlight {
  id           String   @id @default(cuid())
  note         String?
  selectedText String?  @map("selected_text") /// The exact text user selected (optional for backwards compat)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  segmentId String            @map("segment_id")
  segment   TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  themes HighlightTheme[]

  @@map("highlights")
}

/// Theme - Grouping for insights synthesis
model Theme {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  highlights HighlightTheme[]

  @@unique([projectId, name])
  @@map("themes")
}

/// HighlightTheme - Many-to-many join table for highlights and themes
model HighlightTheme {
  highlightId String    @map("highlight_id")
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  themeId String @map("theme_id")
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([highlightId, themeId])
  @@map("highlight_themes")
}

/// ShareLink - Shareable read-only links for projects and sources
model ShareLink {
  id              String    @id @default(cuid())
  token           String    @unique @default(uuid())
  includeEvidence Boolean   @default(true) @map("include_evidence") // Only used for project shares
  includeInsights Boolean   @default(true) @map("include_insights") // Only used for project shares
  expiresAt       DateTime? @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceId String? @map("source_id") // If set = source share, if null = project share
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([token])
  @@index([projectId])
  @@index([sourceId])
  @@map("share_links")
}

/// SpeakerName - Custom name mapping for speakers within a project
model SpeakerName {
  id         String   @id @default(cuid())
  speakerId  String   @map("speaker_id") // Raw speaker ID from transcription (e.g., "speaker_gia")
  customName String   @map("custom_name") // User-assigned name (e.g., "Gia")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, speakerId])
  @@map("speaker_names")
}
