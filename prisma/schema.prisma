// OpenInsights - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============================================
// Enums
// ============================================

enum ProcessingStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Core Models
// ============================================

/// Workspace - Multi-tenant container for projects
model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects Project[]

  @@map("workspaces")
}

/// Project - Research container within a workspace
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sources Source[]
  tags    Tag[]

  @@map("projects")
}

/// Source - Video/audio file for transcription
model Source {
  id        String           @id @default(cuid())
  title     String
  fileName  String           @map("file_name")
  fileUrl   String           @map("file_url")
  fileType  String           @map("file_type")
  duration  Int?             // Duration in seconds
  status    ProcessingStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  segments TranscriptSegment[]

  @@map("sources")
}

/// TranscriptSegment - Timestamped text from transcription
model TranscriptSegment {
  id        String   @id @default(cuid())
  content   String
  startTime Float    @map("start_time") // Time in seconds
  endTime   Float    @map("end_time") // Time in seconds
  speakerId String?  @map("speaker_id")
  // embedding column added via raw SQL for pgvector
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sourceId String @map("source_id")
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  highlights Highlight[]

  @@index([sourceId])
  @@map("transcript_segments")
}

/// Tag - Taxonomy for organizing highlights
model Tag {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#3B82F6")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  highlights Highlight[]

  @@unique([projectId, name])
  @@map("tags")
}

/// Highlight - Tagged selection from transcript
model Highlight {
  id        String   @id @default(cuid())
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  segmentId String            @map("segment_id")
  segment   TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("highlights")
}
